{
  "name": "xeyy",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test --filter=@xeyy/config --filter=@xeyy/registry --filter=@xeyy/cli",
    "validate:config": "node packages/config/src/validate-config.ts",
    "validate:registry": "node packages/registry/src/validate-registry.ts",
    "build:registry": "node packages/registry/src/build-registry.ts",
    "validate:dist": "node packages/registry/src/validate-dist.ts"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
