{
  "name": "xeyyui",
  "version": "0.0.1",
  "description": "StyleX-native component registry CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyxarr/xeyy.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "xeyy": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "pnpm exec tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e:icons": "node scripts/e2e-icons.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "kleur": "^4.1.5",
    "ora": "^8.2.0",
    "prompts": "^2.4.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/prompts": "^2.4.9",
    "@xeyy/config": "workspace:*",
    "@xeyy/eslint-config": "workspace:*",
    "@xeyy/icons": "workspace:*",
    "@xeyy/registry": "workspace:*",
    "@xeyy/typescript-config": "workspace:*",
    "eslint": "10.9.1",
    "tsup": "^8.5.0",
    "typescript": "latest",
    "vitest": "^5.0.0"
  }
}
