{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xeyy.dev/schema/registry-item.json",
  "title": "Xeyy Registry Item",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "registry:ui",
        "registry:component",
        "registry:block",
        "registry:theme",
        "registry:internal"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "docs": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "copyright": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "registry:ui",
              "registry:component",
              "registry:block",
              "registry:theme",
              "registry:internal",
              "example",
              "documentation"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "registryDependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fingerprint": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "stylex": {
      "type": "object",
      "properties": {
        "minVersion": {
          "type": "string"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compiler": {
          "type": "boolean"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "keyboard": {
          "type": "boolean"
        },
        "focusManagement": {
          "type": "boolean"
        },
        "aria": {
          "type": "boolean"
        },
        "tested": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "type",
    "version",
    "source",
    "files"
  ],
  "additionalProperties": false
}
