{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xeyy-registry.vercel.app/schema/registry.json",
  "title": "Xeyy Registry Root",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "homepage": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "name",
    "items"
  ],
  "additionalProperties": false
}
