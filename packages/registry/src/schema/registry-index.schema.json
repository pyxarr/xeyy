{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xeyy.dev/schema/registry-index.json",
  "title": "Xeyy Registry Catalog Index",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "homepage": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "items": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "registry:ui",
              "registry:component",
              "registry:block",
              "registry:theme",
              "registry:internal"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "registryDependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fileCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "section",
          "type",
          "version",
          "fileCount",
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "items"
  ],
  "additionalProperties": false
}
