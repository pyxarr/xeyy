{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xeyy.dev/schema/config.schema.json",
  "title": "Xeyy Config",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "components": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "aliases": {
      "type": "object",
      "properties": {
        "components": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "components"
      ],
      "additionalProperties": false
    },
    "iconLibrary": {
      "type": "string",
      "minLength": 1
    },
    "registries": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "format": "uri"
      }
    },
    "registry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "dist": {
          "type": "string",
          "minLength": 1
        },
        "themes": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "components",
    "theme"
  ],
  "additionalProperties": false
}
